<?xml version="1.0"?>
<?xml-stylesheet href="chrome://global/skin" type="text/css"?>
<?xml-stylesheet href="chrome://mochikit/content/tests/SimpleTest/test.css"
                 type="text/css"?>
<window title="Testing composition, text and query content events"
  xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul">

  <script type="application/javascript"
          src="chrome://mochikit/content/tests/SimpleTest/SimpleTest.js" />

<body  xmlns="http://www.w3.org/1999/xhtml">
<div id="content" style="display: none">
  
</div>
<pre id="test">
</pre>
</body>

<script class="testbody" type="application/javascript">
<![CDATA[

SimpleTest.waitForExplicitFinish();

// Keep completion and cleanup with the owning test. A timed-out child's unload
// must not finish the next test or depend on a still-live window.opener.
var gMouseScrollChild;
var gMouseScrollFinished = false;
var gMouseScrollCleaned = false;
var gMouseScrollPrefService = Components.classes["@mozilla.org/preferences-service;1"]
                                      .getService(Components.interfaces.nsIPrefBranch);
var gMouseScrollPrefNames = [
  "mousewheel.with_alt.action",
  "mousewheel.with_control.action",
  "mousewheel.with_shift.action",
  "mousewheel.with_win.action",
  "mousewheel.with_alt.delta_multiplier_x",
  "mousewheel.with_alt.delta_multiplier_y",
  "mousewheel.with_control.delta_multiplier_x",
  "mousewheel.with_control.delta_multiplier_y",
  "mousewheel.with_shift.delta_multiplier_x",
  "mousewheel.with_shift.delta_multiplier_y",
  "mousewheel.with_win.delta_multiplier_x",
  "mousewheel.with_win.delta_multiplier_y",
  "mousewheel.system_scroll_override_on_root_content.enabled",
  "mousewheel.emulate_at_wm_scroll",
  "mousewheel.windows.vertical_amount_override",
  "mousewheel.windows.horizontal_amount_override",
  "mousewheel.windows.transaction.timeout",
];
var gMouseScrollSavedPrefs = gMouseScrollPrefNames.map(name => {
  var type = gMouseScrollPrefService.getPrefType(name);
  var hadUserValue = gMouseScrollPrefService.prefHasUserValue(name);
  var value;
  if (hadUserValue) {
    if (type == gMouseScrollPrefService.PREF_BOOL) {
      value = gMouseScrollPrefService.getBoolPref(name);
    } else if (type == gMouseScrollPrefService.PREF_INT) {
      value = gMouseScrollPrefService.getIntPref(name);
    } else {
      value = gMouseScrollPrefService.getCharPref(name);
    }
  }
  return {name, type, hadUserValue, value};
});

function cleanupMouseScrollTest()
{
  if (gMouseScrollCleaned) {
    return;
  }
  gMouseScrollCleaned = gMouseScrollFinished = true;
  if (gMouseScrollChild && !gMouseScrollChild.closed) {
    gMouseScrollChild.close();
  }
  for (var pref of gMouseScrollSavedPrefs) {
    if (!pref.hadUserValue) {
      if (gMouseScrollPrefService.prefHasUserValue(pref.name)) {
        gMouseScrollPrefService.clearUserPref(pref.name);
      }
    } else if (pref.type == gMouseScrollPrefService.PREF_BOOL) {
      gMouseScrollPrefService.setBoolPref(pref.name, pref.value);
    } else if (pref.type == gMouseScrollPrefService.PREF_INT) {
      gMouseScrollPrefService.setIntPref(pref.name, pref.value);
    } else {
      gMouseScrollPrefService.setCharPref(pref.name, pref.value);
    }
  }
}

function finishMouseScrollTests()
{
  if (gMouseScrollFinished) {
    return;
  }
  gMouseScrollFinished = true;
  SimpleTest.finish();
}

SimpleTest.registerCleanupFunction(cleanupMouseScrollTest);
window.addEventListener("unload", cleanupMouseScrollTest);
gMouseScrollChild = window.open("window_mouse_scroll_win.html", "_blank",
                               "chrome,width=600,height=600");

]]>
</script>
</window>
