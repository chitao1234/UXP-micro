EXPORTS += [
    'include/mimalloc-new-delete.h',
    'include/mimalloc-override.h',
    'include/mimalloc-stats.h',
    'include/mimalloc.h',
]

SOURCES += [
    'src/static.c',
]

# MinGW experiment: link mimalloc into mozglue.dll on every platform.
#
# Upstream builds a shared mimalloc.dll on Windows and relies on
# mimalloc-redirect32.dll to rewrite the import tables of already-loaded
# modules. That redirect initializes from mimalloc's process attach hook,
# after msvcrt has already handed out pointers, and the 32-bit MinGW loader
# here runs it too late for a mixed msvcrt/mimalloc process.
#
# Linking mimalloc into mozglue and exporting malloc/calloc/realloc/free from
# mozglue is the same arrangement jemalloc already uses in this tree: every
# Gecko module that links mozglue binds its allocation entry points to
# mozglue.dll (see build/gecko_templates.mozbuild).
FINAL_LIBRARY = 'mozglue'

LOCAL_INCLUDES += [
    '/memory/mimalloc/include',
]

DEFINES['MI_DEFAULT_PURGE_DECOMMITS'] = 0
DEFINES['MI_DEFAULT_PURGE_DELAY'] = 500
DEFINES['MI_DEFAULT_GENERIC_COLLECT'] = 50000

if CONFIG['OS_TARGET'] == 'Darwin':
    DEFINES['MI_SHARED_LIB'] = True
    DEFINES['MI_SHARED_LIB_EXPORT'] = True

if CONFIG['OS_TARGET'] != 'WINNT':
    DEFINES['MI_MALLOC_OVERRIDE'] = True
    DEFINES['MI_USE_ENVIRON'] = 0

if CONFIG['OS_TARGET'] == 'Darwin':
    DEFINES['MI_OSX_ZONE'] = True
