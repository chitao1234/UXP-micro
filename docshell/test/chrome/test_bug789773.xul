<?xml version="1.0"?>
<?xml-stylesheet type="text/css" href="chrome://global/skin"?>
<?xml-stylesheet type="text/css" href="chrome://mochikit/content/tests/SimpleTest/test.css"?>
<!--
https://bugzilla.mozilla.org/show_bug.cgi?id=789773
-->
<window title="Mozilla Bug 789773"
        xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul">
  <script type="application/javascript" src="chrome://mochikit/content/tests/SimpleTest/SimpleTest.js"/>

  <!-- test results are displayed in the html:body -->
  <body xmlns="http://www.w3.org/1999/xhtml">
  <a href="https://bugzilla.mozilla.org/show_bug.cgi?id=789773"
     target="_blank">Mozilla Bug 789773</a>
  </body>

  <!-- test code goes here -->
  <script type="application/javascript">
  <![CDATA[
  const Cc = Components.classes;
  const Ci = Components.interfaces;
  const Cr = Components.results;
  const Cu = Components.utils;

  /* Test for Bug 789773.
   *
   * See comment 50 for the situation we're testing against here.
   *
   * Note that the failure mode of this test is to hang, and hang the browser on quit.
   * This is an unfortunate occurance, but that's why we're testing it.
   */
  SimpleTest.waitForExplicitFinish();

  Cu.import("resource://gre/modules/Services.jsm");
  var browserChromeURI = Services.io.newURI(
    Services.prefs.getCharPref("browser.chromeURL"), null, null);
  var targetURI = Services.io.newURI("about:mozilla", null, null);
  var restrictionPref = "browser.link.open_newwindow.restriction";
  var hadRestrictionPref = Services.prefs.prefHasUserValue(restrictionPref);
  var oldRestriction = Services.prefs.getIntPref(restrictionPref);
  var listenerRegistered = false;
  var popup = null;
  SimpleTest.registerCleanupFunction(function() {
    if (listenerRegistered) {
      webProgress.removeProgressListener(testProgressListener);
      listenerRegistered = false;
    }
    if (popup && !popup.closed) {
      popup.close();
    }
    if (hadRestrictionPref) {
      Services.prefs.setIntPref(restrictionPref, oldRestriction);
    } else {
      Services.prefs.clearUserPref(restrictionPref);
    }
  });

  var calledListenerForBrowserChrome = false;
  var testProgressListener = {
    START_DOC: Ci.nsIWebProgressListener.STATE_START | Ci.nsIWebProgressListener.STATE_IS_DOCUMENT,
    onStateChange: function(wp, req, stateFlags, status) {
      // Chrome channels have a resolved file/resource name. Match their
      // original URI against the canonical configured browser chrome URI.
      var channel;
      try {
        channel = req.QueryInterface(Ci.nsIChannel);
      } catch (e) {
        return;
      }
      var requestURI = channel.originalURI;
      if (requestURI.equals(browserChromeURI)) {
        wp.DOMWindow; // Force the lazy creation of a DOM window.
        calledListenerForBrowserChrome = true;
      }
      if (requestURI.equals(targetURI) && (stateFlags & Ci.nsIWebProgressListener.STATE_STOP))
        finishTest();
    },
    QueryInterface: function(iid) {
      if (iid.equals(Ci.nsISupportsWeakReference) ||
          iid.equals(Ci.nsIWebProgressListener))
        return this;
      throw Cr.NS_ERROR_NO_INTERFACE;
    }
  }

   // Add our progress listener
   var webProgress = Cc['@mozilla.org/docloaderservice;1'].getService(Ci.nsIWebProgress);
   webProgress.addProgressListener(testProgressListener, Ci.nsIWebProgress.NOTIFY_STATE_REQUEST);
   listenerRegistered = true;

   // This regression requires creating native browser chrome, not diverting
   // the feature-requesting popup into a tab (the app default since 653eb56).
   Services.prefs.setIntPref(restrictionPref, 2);
   popup = window.open(targetURI.spec, "_blank", "width=640,height=400");

   // Wait for the window to load.
   function finishTest() {
     webProgress.removeProgressListener(testProgressListener);
     listenerRegistered = false;
     ok(true, "Loaded the popup window without spinning forever in the event loop!");
     ok(calledListenerForBrowserChrome,
        "Should have called the progress listener for " + browserChromeURI.spec);
     popup.close();
     SimpleTest.finish();
   }

  ]]>
  </script>
</window>
