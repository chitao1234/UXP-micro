if CONFIG['MOZ_FOLD_LIBS']:
    Library('plds4')
else:
    SharedLibrary('plds4')
    SOURCES += ['/nsprpub/lib/ds/plvrsion.c']
    USE_LIBS += ['nspr4']

# We allow warnings for third-party code that can be updated from upstream.
# TODO: fix NSPR warnings and remove this
ALLOW_COMPILER_WARNINGS = True

DEFINES['_NSPR_BUILD_'] = True

# The fold links these objects into nss3.dll/xul, and NSS tools resolve NSPR
# through the folded DLL's import library (security/moz.build sets
# nspr_libs='nss'). Their definitions must therefore keep the dllexport
# declarations, so NSPR_STATIC applies to consumers only.
CFLAGS += ['-UNSPR_STATIC']
CXXFLAGS += ['-UNSPR_STATIC']

LOCAL_INCLUDES += [
    '/config/external/nspr',
    '/nsprpub/pr/include',
]

EXPORTS.nspr += [
    '/nsprpub/lib/ds/plarena.h',
    '/nsprpub/lib/ds/plarenas.h',
    '/nsprpub/lib/ds/plhash.h',
]

SOURCES += [
    '/nsprpub/lib/ds/plarena.c',
    '/nsprpub/lib/ds/plhash.c',
]
